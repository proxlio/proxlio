# ══════════════════════════════════════════════════════════
#  Proxlio — Configuration
#  Copier ce fichier en .env et renseigner les valeurs.
#    cp .env.example .env && nano .env
# ══════════════════════════════════════════════════════════


# ── Variables REQUISES ─────────────────────────────────────

# Token du Cloudflare Tunnel.
# Obtenir dans : https://one.dash.cloudflare.com → Networks → Tunnels
# Créer un tunnel, copier le token affiché lors de l'installation.
CLOUDFLARE_TUNNEL_TOKEN=

# Votre domaine principal (ex: mondomaine.com).
# Utilisé pour générer les certificats SSL via Let's Encrypt dans NPM.
DOMAIN=

# Email pour les notifications Let's Encrypt (expiration de certificat, etc.).
LETSENCRYPT_EMAIL=


# ── Variables OPTIONNELLES ─────────────────────────────────

# Répertoire d'installation de Proxlio.
# Par défaut : répertoire courant au moment du déploiement.
# INSTALL_DIR=/opt/proxlio

# Port d'écoute de l'interface d'administration AdGuard Home.
# Changer si le port 3000 est déjà utilisé sur l'hôte.
ADGUARD_PORT=3000
