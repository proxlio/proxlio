# ══════════════════════════════════════════════════════════
#  Proxlio — Configuration
#  Copy this file to .env and fill in your values:
#    cp .env.example .env && nano .env
# ══════════════════════════════════════════════════════════


# ── Required ───────────────────────────────────────────────

# Your primary domain (e.g. yourdomain.com).
# Used to issue SSL certificates via Let's Encrypt.
DOMAIN=

# Email for Let's Encrypt notifications (certificate expiry, etc.).
LETSENCRYPT_EMAIL=

# Cloudflare API token.
# Create one at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:Read (all zones) + Cloudflare Tunnel:Edit
CF_API_TOKEN=

# Internal name for your Cloudflare Tunnel (only visible in your dashboard).
CF_TUNNEL_NAME=proxlio

# Cloudflare Tunnel token.
# Populated automatically by install.sh if cloudflared CLI is available.
# Otherwise: create your tunnel at https://one.dash.cloudflare.com → Networks → Tunnels
# and paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=


# ── Auto-detected (set by install.sh) ──────────────────────

# LAN IP of this machine. Used for AdGuard DNS rewrites so LAN traffic stays local.
# Override if auto-detection picks the wrong interface (e.g. on a multi-homed host).
# HOST_IP=192.168.1.x


# ── Optional ───────────────────────────────────────────────

# Admin port for AdGuard Home UI. Change if 3000 is already in use.
ADGUARD_PORT=3000

# Override NPM and AdGuard URLs if they run on non-default addresses.
# NPM_URL=http://localhost:81
# ADGUARD_URL=http://localhost:3000

# NPM credentials used by add-service.sh to create proxy hosts via API.
# Update these after changing the NPM admin password.
# NPM_EMAIL=admin@example.com
# NPM_PASSWORD=changeme
